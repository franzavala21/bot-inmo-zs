# Copiá este archivo como .env y completá. NUNCA subas .env ni pegues claves en el chat.
TOKKO_API_KEY=
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Secreto compartido entre el worker (Railway) y la web (Vercel). Generalo con: openssl rand -hex 32
INBOUND_HMAC_SECRET=
# Emails que pueden entrar al panel, separados por coma
ALLOWED_EMAILS=
# URL de la web (para que el worker le mande los mensajes)
WEB_BASE_URL=http://localhost:3000
# Secreto para los cron de Vercel
CRON_SECRET=
# Tope de gasto diario del modelo en USD
DAILY_SPEND_CAP_USD=5

# ───── API oficial de WhatsApp (Meta). Se cargan en Vercel. ─────
# Token permanente de un usuario del sistema (Business Manager), con whatsapp_business_messaging y whatsapp_business_management
META_ACCESS_TOKEN=
# App Secret de la app de Meta (firma del webhook)
META_APP_SECRET=
# Texto inventado por ustedes; el mismo se pega en Meta al configurar el webhook. openssl rand -hex 16
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v26.0

# ───── Worker de WhatsApp (Railway). En Railway se cargan en el servicio, no en un archivo. ─────
# En Railway usar SUPABASE_URL (mismo valor que NEXT_PUBLIC_SUPABASE_URL) y SUPABASE_SERVICE_ROLE_KEY.
CHANNEL_SLUG=ventas
# Carpeta de la sesión de WhatsApp. En Railway: /data/auth (volumen montado en /data).
AUTH_DIR=./auth
# baileys = WhatsApp real; fake = probar el circuito sin chip
WA_TRANSPORT=baileys
BAILEYS_LOG_LEVEL=silent
